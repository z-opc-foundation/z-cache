<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径）：继承第三方地板 + import 兄弟仓 fleet
         + Java 8 的 pluginManagement。以前这里的 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT —— 那个
         pom 只存在于作者本机的 ~/.m2（relativePath 指的 ../pom.xml 根本不存在），换台机器连 pom
         都读不动；对外发布的件靠 flatten oss 把 parent 剥掉了，所以 Central 消费者没受影响，
         但"源码能被别人构建"这件事一直是假的。
         relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.0</version>
        <relativePath/>
    </parent>
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-cache</artifactId>
    <version>1.3.6</version>
    <packaging>pom</packaging>
    <modules>
        <module>z-cache-common</module>
        <module>z-cache-core</module>
        <module>z-cache-client</module>
        <module>z-cache-server</module>
        <module>z-cache-spring-boot-starter</module>
    </modules>

    <name>z-cache</name>
    <description>Zero-copy 二进制编解码 + Netty RPC + Spring Boot Starter 的分布式缓存基础设施</description>
    <url>https://github.com/yuku123/z-cache</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-cache.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-cache.git</developerConnection>
        <url>https://github.com/yuku123/z-cache</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- 版本口径全部由 parent 下发，这里只留**本仓有意与地板不同**的那一格：
             netty 4.1.138.Final / z-util 1.0.13 与 floor+fleet 面值一致 ⇒ 属性删掉，
             由 parent 的 dependencyManagement 供（曾经这里自己钉一份，就是"每个仓自己起名字"的账）。
             log4j2 反过来必须留着：地板是 2.25.4，本仓要 2.17.2，理由是下面这段零漂移判断。 -->
        <log4j2.version>2.17.2</log4j2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 本仓自家 5 个模块钉 ${project.version}。这一格不是装饰：fleet 里 z-cache 那一格
                 钉的是 repo1 上最新的 **1.3.5**，而继承来的 DM 会改写**传递依赖**的版本 ⇒
                 z-cache-server 的 shade fat jar 实测把 1.3.5 的 z-cache-common 字节码打进了
                 1.3.6 的包里（迁移前更糟：z-opc 的 DM 压成 1.3.4）。写上这 5 条以后 child 的 DM
                 压过 parent 的，tree 与 shaded jar 都回到 1.3.6。
                 每个多模块仓迁到 parent 都要做这一步，否则"仓内构建"会被对外面值反向污染。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-cache-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-cache-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-cache-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-cache-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-cache-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- netty-bom 的 import 删掉：z-boot-dependencies 已经 import 了同一个
                 io.netty:netty-bom（面值 4.1.138.Final，与本仓迁移前逐字节相同，
                 迁移后 dependency:tree 的 io.netty 9 件版本一件没动）。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 日志只有一个家族：log4j2。钉 2.17.2 不是"随手沿用旧值"，是零漂移：core/client 今天引的
                 就是 2.17.2，而 spring-boot 2.7.18 的 `spring-boot-starter-log4j2` 带的
                 log4j-core / log4j-slf4j-impl / log4j-jul 也全是 2.17.2 ⇒ "我们的 BOM"与"spring 那一侧"
                 是同一版，不会像 13t 之前那样在测试类路径上同时出现 2.17.2 的 api 与 2.25.4 的桥。
                 抬版本是另一个决定（要连 Java 8 字节码一起验），不在这一格里顺手做。
                 ⚠ 光靠上面那条 import **顶不住**：地板把 log4j-api/core/jul/slf4j-impl 四条**直接**钉在
                 2.25.4，而"继承来的直接 DM 条目"优先级高于"本仓 import 进来的 BOM" —— 实测迁移后
                 dependency:tree 里 4 件全漂到 2.25.4，所以必须按坐标逐条写直接条目才能压回去。
                 这四条是量出来的（tree 里 io.github...log4j 命中 4 个坐标），不是抄的。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-jul</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <!-- snakeyaml 同理要显式顶住：monorepo 那侧的 DM 钉的是 2.0（CVE-2022-1471 那一串），
                 而地板跟着 spring-boot-dependencies 2.7.18 走 1.30 ⇒ 不写这条就静默降版本。
                 这属于"该由地板统一决定"的格子，先在本仓保住不掉，最终口径待 CEO 判。 -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.0</version>
            </dependency>
            <!-- slf4j-api / logback-classic 的 managed 条目整批删掉：这一族不再是我们的
                 实现选择（代码里 18 处 logger 全部 import org.apache.logging.log4j，
                 0 处 import org.slf4j，0 处 import ch.qos.logback —— 现读，见 CHANGELOG 13u。
                 这 18 支里有 2 支是 13u 才接回来的：它们此前整支走 java.util.logging，
                 而 JUL 的 LogManager 与 log4j2 的同名不同物，按 import 数出来的是 16。
                 留着它们＝留着一个"谁都能误引"的入口，而误引的代价要到运行时才现形
                 （两条 binding 同时在类路径上时，输出走哪家取决于加载顺序）。 -->
        </dependencies>
    </dependencyManagement>
    <dependencies>
    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承，
         子模块一律不再各自声明 junit；版本由根 DM / 地板 junit-bom 统一下发）：
           * junit-jupiter        — JUnit 5 新测试（API + 引擎）
           * junit-vintage-engine — 老 JUnit 4 测试（org.junit.Test）跑在 JUnit 5 平台上 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!-- 常开（不挂 central profile）：挂 profile 时 `mvn install` 不带 -P central，
                 装进本地仓的 pom 仍然带着 com.zifang:z-opc:1.0.0-SNAPSHOT 这个永不存在的
                 parent ⇒ 本机消费者读到的还是废 pom。对照实测（同目录形状、只换 flatten 位置）：
                 挂 profile 一侧每个入库 pom 都带 <parent> 且聚合 pom 的 parent 悬空，常开一侧为 0。
                 版本钉 1.5.0：门禁机 250（Maven 3.6.0）实测 1.5.0 rc=0，
                 1.6.0/1.7.2 rc=1 “requires Maven version 3.6.3”。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <!-- true 跳过 javadoc 生成（用于本地 dry-run）；真发 Central 时改为 false -->
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <!-- true 跳过 GPG 签名（用于本地 dry-run）；真发 Central 时改为 false -->
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 发布用的 pom 必须自包含：monorepo 的 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT，
                         它永远不会（也不能）出现在 Central 上。带着这个 parent 发出去的构件，
                         任何外部消费者第一次解析就报
                         "Could not find artifact com.zifang:z-opc:pom:1.0.0-SNAPSHOT"，
                         等于构件全废。flatten 在 process-resources 生成去掉 parent、
                         并把继承来的版本全部写死的 pom，install/deploy 用它替换（updatePomFile）。
                         本地 monorepo 构建链不受影响：不带 -P central 时不执行。 -->

                    <!-- 中央发布场景下，禁用 maven-deploy-plugin 的 default-deploy，
                         改由 central-publishing-maven-plugin 接管（不会重复 deploy 到 snapshotRepository） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <!-- sources.jar：Maven Central 强制要求 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Maven Central 强制要求 javadoc.jar；用 doclint=none 规避 Java 8+ 的 HTML5 校验 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <!-- 这里原先写的是 ${compile.version}：全仓 11 个 pom 引用这个属性，
                                 只有本仓没有定义它，父链（com.zifang:z-opc）里也没有 ⇒ 传到
                                 javadoc 插件手里是字面量 "${compile.version}"。因为上面挂着
                                 failOnError=false，它不炸构建，只让 -source 变成无效参数，
                                 所以这处点伤一直没人看见。改成 parent 下发的 Java 口径。 -->
                            <source>${maven.compiler.source}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- GPG 签名：passphrase 通过环境变量 CENTRAL_GPG_PASSPHRASE 传入 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <!-- 显式传 pinentry-mode loopback + no-tty，让 mvn-gpg-plugin
                                 在 sandbox / 无 gpg-agent 环境也能签名 -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central Portal 上传插件（替代老的 nexus-staging-maven-plugin） -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- waitUntil=uploaded：每个子模块 deploy 完只等上传成功不等 published -->
                            <waitUntil>uploaded</waitUntil>
                            <!-- waitMaxTime=1800s（30 分钟）：中央 Portal validation 可能慢 -->
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>central-dryrun</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <central.gpg.skip>true</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>

        <!-- 声明的 Java 8 底线要有尺，否则它只是一句注释。
             source/target 8 只在 JDK 9+ 的 bootclasspath 上"看起来"过了：javac 照样允许
             Map.of / List.of 这类 Java 9 才有的 API，产出的 class 也还是 52.0，于是问题一路
             活到真正跑在 Java 8 上的机器才炸。实测：同一棵树 macOS/JDK25 全绿，
             250/JDK1.8.0_362 在 z-cache-core 的 testCompile 上 24 处 "cannot find symbol
             method of(java.lang.String,java.lang.String) location: interface java.util.Map"。
             release 8（javac 的 release 选项）用 JDK 9 之前的系统模块签名编译，
             越界 API 在本地就直接编译失败。
             JDK 8 上这个 profile 不激活（javac 8 不认 release 选项），source/target 8 照旧。 -->
        <profile>
            <id>java8-floor-on-jdk9plus</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>
    </profiles>
</project>