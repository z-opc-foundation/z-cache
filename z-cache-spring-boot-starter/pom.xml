<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-cache</artifactId>
        <version>1.3.6</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <version>1.3.6</version>
    <artifactId>z-cache-spring-boot-starter</artifactId>
    <name>z-cache-spring-boot-starter</name>
    <description>z-cache Spring Boot 自动配置与模板组件</description>

    <url>https://github.com/yuku123/z-cache</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-cache.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-cache.git</developerConnection>
        <url>https://github.com/yuku123/z-cache</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-cache-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 2026-10-03: host/ 包 (CacheProxyController / ZCacheEmbeddedServerConfig,
             自 z-opc main-starter 平移) 引 RedisServer/MemoryStore.
             provided: 宿主内嵌模式才用; 纯 client 消费方不背这个包. -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-cache-core</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- host/CacheProxyController 是 @RestController: servlet + spring-webmvc 由宿主供 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>5.3.31</version>
            <scope>provided</scope>
        </dependency>
        <!-- host 类的 jackson (ObjectMapper) 由宿主运行时供。
             原来这里还有一条 slf4j-api，是给 ZCacheEmbeddedServerConfig 用的；
             该类已改用 log4j2（LogManager.getLogger），本模块 src/main 下再无 org.slf4j 引用，
             这条依赖就成了纯外来日志家族 —— LoggingFamilyGuardTest 判它违规。
             记日志只走 log4j2 一家，别为了少改一个 import 把外来家族挂在 classpath 上。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.5</version>
            <scope>provided</scope>
        </dependency>
        <!-- 记日志走 log4j2：ZCacheEmbeddedServerConfig 从 slf4j 换过来后，
             本模块 src/main 有了 log4j2 调用，就必须自己声明 log4j-api
             （只带 API 不带实现，版本由 parent/fleet 统一下发，与 z-cache-core 同口径）。
             LoggingFamilyGuardTest 的 aModuleThatLogsDeclaresTheApiItLogsThrough 守着这条：
             记日志的模块没声明自己用的那支 API ⇒ 换机器/换 parent 时可能直接编译不过。 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>2.7.18</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>2.7.18</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.7.18</version>
            <scope>test</scope>
            <exclusions>
                <!-- spring 容器的默认日志那一族整条拔掉：它带的是
                     `ch.qos.logback:logback-classic` + `org.apache.logging.log4j:log4j-to-slf4j`
                     （方向正好反过来：log4j2 的事件被灌进 slf4j→logback），
                     还顺手把 log4j-api 抬成 2.25.4 —— 于是同一个测试类路径上出现过两个 log4j2 版本。
                     拔掉之后由下面那支 starter-log4j2 供实现，全仓只剩一个方向：log4j2 自己。 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <version>2.7.18</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
