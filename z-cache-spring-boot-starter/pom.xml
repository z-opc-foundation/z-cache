<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-cache</artifactId>
        <version>1.3.6</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <version>1.3.6</version>
    <artifactId>z-cache-spring-boot-starter</artifactId>
    <name>z-cache-spring-boot-starter</name>
    <description>z-cache Spring Boot 自动配置与模板组件</description>

    <url>https://github.com/yuku123/z-cache</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-cache.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-cache.git</developerConnection>
        <url>https://github.com/yuku123/z-cache</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-cache-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>2.7.18</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>2.7.18</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.7.18</version>
            <scope>test</scope>
            <exclusions>
                <!-- spring 容器的默认日志那一族整条拔掉：它带的是
                     `ch.qos.logback:logback-classic` + `org.apache.logging.log4j:log4j-to-slf4j`
                     （方向正好反过来：log4j2 的事件被灌进 slf4j→logback），
                     还顺手把 log4j-api 抬成 2.25.4 —— 于是同一个测试类路径上出现过两个 log4j2 版本。
                     拔掉之后由下面那支 starter-log4j2 供实现，全仓只剩一个方向：log4j2 自己。 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <version>2.7.18</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
